# Verdict demo - optional live LLM mode
# Default: leave VITE_VERDICT_MODE unset or set to "seed" (no API key needed)

VITE_VERDICT_MODE=seed

# OpenAI-compatible gateway (OpenAI / Z.ai / GLM / other compatible providers)
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini
VITE_LLM_TIMEOUT_MS=15000
